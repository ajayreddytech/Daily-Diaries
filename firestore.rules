rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own diary:
    //   users/{uid}/days/{yyyy-mm-dd}  -> one page per day
    //   users/{uid}/tasks/{taskId}     -> the blueprint task list
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
